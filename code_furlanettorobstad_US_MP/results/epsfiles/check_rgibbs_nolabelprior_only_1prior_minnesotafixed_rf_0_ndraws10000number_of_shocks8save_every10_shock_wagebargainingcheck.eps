  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 450
  /ImageMatrix [29 0 0 450 0 0]
  /Width 29
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec

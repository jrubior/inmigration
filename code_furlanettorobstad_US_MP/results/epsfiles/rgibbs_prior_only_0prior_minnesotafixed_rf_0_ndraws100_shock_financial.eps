%AXGEndBitmap
GR
GR
GS
[0.48011 0 0 0.48 336.07684 36] CT
[1 0 0 1 0 0] CT
N
-700 -75 M
758 -75 L
758 1800 L
-700 1800 L
-700 -75 L
cp
clip
GS
0 0 translate
700 900 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 900
  /ImageMatrix [700 0 0 900 0 0]
  /Width 700
  /BitsPerComponent 8
>> image
} stopped {handleerror} if

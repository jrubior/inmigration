%AXGEndBitmap
GR
GR
GS
[0.48 0 0 0.48 432.00003 36] CT
[1 0 0 1 0 0] CT
N
-900 -75 M
975 -75 L
975 1800 L
-900 1800 L
-900 -75 L
cp
clip
GS
0 0 translate
900 900 scale
%AXGBeginBitmap: java.awt.image.BufferedImage
{{
/RawData currentfile /ASCII85Decode filter def
/Data RawData /FlateDecode filter def
/DeviceRGB setcolorspace
<<
  /ImageType 1
  /Decode [0 1 0 1 0 1]
  /DataSource Data
  /Height 900
  /ImageMatrix [900 0 0 900 0 0]
  /Width 900
  /BitsPerComponent 8
>> image
} stopped {handleerror} if
  RawData flushfile
} exec
